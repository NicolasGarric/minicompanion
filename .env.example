# Copy to .env.local and fill in from Supabase: Project Settings > API.
# Both values are public by design (data is protected by Row Level Security).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Donations (optional): Stripe Payment Links, public URLs (https://buy.stripe.com/...).
# Without them the support page says donations open soon.
VITE_STRIPE_DONATE_URL=
VITE_STRIPE_DONATE_MONTHLY_URL=
# Stripe customer portal login link, to stop or change a monthly support (optional)
VITE_STRIPE_PORTAL_URL=
